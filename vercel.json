{
  "version": 2,
  "functions": {
    "api/export-docx.js": {
      "includeFiles": [
        "node_modules/docx/**"
      ]
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/signup", "dest": "/signup.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/thankyou", "dest": "/thankyou.html" },
    { "src": "/resources", "dest": "/resources.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/refunds", "dest": "/refunds.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
